# Appwrite Web SDK configuration
#
# Copy this file to `.env.local` and fill in the values from your Appwrite
# console. These are exposed in the browser bundle (that's expected for the
# Web SDK — they are public, not secrets). Restart `npm run dev` after editing.
#
# Until all four are set, the contact form falls back to opening a mailto: link.

# Console → Settings → your API endpoint (Appwrite Cloud default below)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Console → Project → Settings → Project ID
VITE_APPWRITE_PROJECT_ID=

# Console → Databases → your database → Database ID
VITE_APPWRITE_DATABASE_ID=

# Console → Databases → your database → your table → Table ID
# (older Appwrite projects call this a Collection ID — same value)
VITE_APPWRITE_TABLE_ID=
